# Firecrawl Monitor v1 preflight.
# Copy to an ignored local secret env file, then fill FIRECRAWL_API_KEY before real monitor creation.
# For the full investment research registry, validate docs\examples\firecrawl_monitor_registry.sample.json first.
# Public webhook path:
# https://<public-investment-app-host>/api/v1/public-ir-sec/firecrawl-monitor/webhook
# Firecrawl must send one of: X-Firecrawl-Webhook-Secret, X-Webhook-Secret, or Authorization: Bearer <secret>.
# Add webhook.url to each monitor entry before --require-monitor-webhook / --require-create-ready.
FIRECRAWL_MONITOR_ENABLED=false
FIRECRAWL_MONITOR_DRY_RUN=true
FIRECRAWL_API_KEY=
FIRECRAWL_MONITOR_WEBHOOK_SECRET=replace-with-long-random-secret
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_MONITOR_SOURCES_JSON={"monitors":[{"name":"KR policy and regulatory monitor","schedule":{"text":"daily at 8am","timezone":"Asia/Seoul"},"goal":"Alert when Korean financial, industrial, trade, competition, or disclosure policy pages add or change items that may affect portfolio risk.","judgeEnabled":true,"targets":[{"type":"scrape","urls":["http://www.fsc.go.kr/about/fsc_bbs_rss/?fid=0111","https://www.korea.kr/briefing/pressReleaseList.do"],"scrapeOptions":{"formats":["markdown",{"type":"changeTracking","modes":["git-diff"]}],"onlyMainContent":true,"removeBase64Images":true,"blockAds":true}}],"retentionDays":45}]}
