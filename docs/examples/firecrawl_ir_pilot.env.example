# Firecrawl IR hosted scrape pilot.
# Copy to a local secret env file such as backend\.env or another ignored path,
# then fill FIRECRAWL_API_KEY. Do not commit real secret values.

FIRECRAWL_IR_ENABLED=true
FIRECRAWL_IR_DRY_RUN=true
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_IR_MCP_VERSION=3.17.0
FIRECRAWL_IR_SOURCES_JSON={"items":[{"company":"Apple","ticker":"AAPL","raw_url":"https://investor.apple.com/","page_title":"Apple Investor Relations"},{"company":"Joby Aviation","ticker":"JOBY","raw_url":"https://ir.jobyaviation.com/","page_title":"Joby Aviation Investor Relations"}]}
